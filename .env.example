# Copia este fichero a .env y rellénalo:  cp .env.example .env
# .env NO se sube al repositorio (está en .gitignore).

# Clave de AEMET OpenData (gratuita): https://opendata.aemet.es/centrodedescargas/altaUsuario
# Sin clave, la lluvia y los avisos de AEMET salen como SIN DATOS; el resto funciona.
AEMET_API_KEY=

# true  -> la web enseña DATOS DE DEMOSTRACIÓN (ejemplo inventado, etiquetado en cada pantalla).
#          No se consulta ninguna fuente real.
# false -> datos reales.
DEMO_LIVE_FALLBACK=false
